local function ActivateNearbyPrompt(Root)

    local ClosestPrompt = nil
    local ClosestDistance = 12

    for _, Object in ipairs(workspace:GetDescendants()) do

        if Object:IsA("ProximityPrompt") then

            local Part = Object.Parent

            if Part and Part:IsA("BasePart") then

                local Distance =
                    (Part.Position - Root.Position).Magnitude

                if Distance <= ClosestDistance then
                    ClosestDistance = Distance
                    ClosestPrompt = Object
                end

            end
        end
    end

    if ClosestPrompt then

        pcall(function()
            fireproximityprompt(ClosestPrompt)
        end)

        return true
    end

    return false
end

--========================================================--
-- TELEPORTE
--========================================================--

local Busy = false

local function TeleportAndInteract(X, Y, Z)

    if Busy then
        return
    end

    local Character = Player.Character

    if not Character then
        return
    end

    local Root =
        Character:FindFirstChild("HumanoidRootPart")

    if not Root then
        return
    end

    Busy = true

    Root.CFrame = CFrame.new(X, Y, Z)

    task.wait(0.15)

    Root.CFrame =
        CFrame.new(Root.Position) *
        CFrame.Angles(math.rad(-90), 0, 0)

    task.wait(0.15)

    ActivateNearbyPrompt(Root)

    task.wait(0.25)

    Busy = false
end

