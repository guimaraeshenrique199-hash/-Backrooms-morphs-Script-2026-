--========================================================--
-- EFEITO AFUNDAR
--========================================================--

local function PressEffect(Button)

    local OriginalSize = Button.Size
    local OriginalPosition = Button.Position

    local function Normal()

        TweenService:Create(
            Button,
            TweenInfo.new(0.08, Enum.EasingStyle.Quad),
            {
                Size = OriginalSize,
                Position = OriginalPosition
            }
        ):Play()

    end

    Button.MouseButton1Down:Connect(function()

        TweenService:Create(
            Button,
            TweenInfo.new(0.08, Enum.EasingStyle.Quad),
            {
                Size = UDim2.new(
                    OriginalSize.X.Scale,
                    OriginalSize.X.Offset - 4,
                    OriginalSize.Y.Scale,
                    OriginalSize.Y.Offset - 4
                ),

                Position = UDim2.new(
                    OriginalPosition.X.Scale,
                    OriginalPosition.X.Offset + 2,
                    OriginalPosition.Y.Scale,
                    OriginalPosition.Y.Offset + 2
                )
            }
        ):Play()

    end)

    Button.MouseButton1Up:Connect(Normal)
    Button.MouseLeave:Connect(Normal)
end

