--========================================================--
-- EFEITO AFUNDAR
--========================================================--

local function PressEffect(Button)

	local Scale = Instance.new("UIScale")
	Scale.Name = "PressScale"
	Scale.Scale = 1
	Scale.Parent = Button

	local function PressDown()

		TweenService:Create(
			Scale,
			TweenInfo.new(
				0.07,
				Enum.EasingStyle.Quad,
				Enum.EasingDirection.Out
			),
			{Scale = 0.94}
		):Play()

	end

	local function Release()

		TweenService:Create(
			Scale,
			TweenInfo.new(
				0.09,
				Enum.EasingStyle.Back,
				Enum.EasingDirection.Out
			),
			{Scale = 1}
		):Play()

	end

	Button.InputBegan:Connect(function(Input)

		if Input.UserInputType == Enum.UserInputType.MouseButton1
			or Input.UserInputType == Enum.UserInputType.Touch then

			PressDown()

		end

	end)

	Button.InputEnded:Connect(function(Input)

		if Input.UserInputType == Enum.UserInputType.MouseButton1
			or Input.UserInputType == Enum.UserInputType.Touch then

			Release()

		end

	end)

	Button.MouseLeave:Connect(Release)

end

--========================================================--
-- ENCONTRAR PROMPT
--========================================================--

local function GetPromptPart(Prompt)

	if Prompt.Parent:IsA("Attachment") then

		local Parent = Prompt.Parent.Parent

		if Parent and Parent:IsA("BasePart") then
			return Parent
		end

	end

	if Prompt.Parent:IsA("BasePart") then
		return Prompt.Parent
	end

	return nil
end

--========================================================--
-- AUTO-CLICK DO PROMPT
--========================================================--

local function AutoClickPrompt(Prompt)

	if not Prompt then
		return false
	end

	if not Prompt.Enabled then
		return false
	end

	local Success = pcall(function()

		Prompt:InputHoldBegin()

		task.wait(
			math.max(
				Prompt.HoldDuration,
				0.08
			)
		)

		Prompt:InputHoldEnd()

	end)

	return Success
end

--========================================================--
-- INTERAÇÃO PRÓXIMA
--========================================================--

local function ActivateNearbyPrompt(Root)

	local ClosestPrompt = nil
	local ClosestDistance = 12

	for _, Object in ipairs(workspace:GetDescendants()) do

		if Object:IsA("ProximityPrompt")
			and Object.Enabled then

			local Part = GetPromptPart(Object)

			if Part then

				local Distance =
					(Part.Position - Root.Position).Magnitude

				if Distance <= ClosestDistance then

					ClosestDistance = Distance
					ClosestPrompt = Object

				end

			end

		end

	end

	if ClosestPrompt then

		AutoClickPrompt(ClosestPrompt)

		return true
	end

	return false
end

