end

local function UpdateIndicators()

	if not TrophyOn then

		for _, Object in
			ipairs(TrophyFolder:GetChildren()) do

			Object:Destroy()

		end

		return
	end

	local Existing = {}

	for _, Object in
		ipairs(workspace:GetDescendants()) do

		if Object:IsA("ProximityPrompt")
			and Object.Enabled then

			local ID =
				Object:GetDebugId()

			Existing[ID] = true

			CreateIndicator(Object)

			local Part =
				GetPromptPart(Object)

			local Billboard =
				TrophyFolder:FindFirstChild(ID)

			local Character =
				Player.Character

			local Root =
				Character and
				Character:FindFirstChild(
					"HumanoidRootPart"
				)

			if Part and Root and Billboard then

				local Distance =
					(Part.Position -
					Root.Position).Magnitude

				local Label =
					Billboard:
					FindFirstChildOfClass(
						"TextLabel"
					)

				if Label then

					local Icon

					if UserInputService.TouchEnabled then
						Icon = "🖐️"
					else
						Icon = "E"
					end

					Label.Text =
						Icon ..
						" • " ..
						math.floor(Distance) ..
						"m"

				end

			end

		end

	end

	for _, Object in
		ipairs(TrophyFolder:GetChildren()) do

		if not Existing[Object.Name] then
			Object:Destroy()
		end

	end

end

