local Busy = false

local function TeleportAndInteract(X, Y, Z)

	if Busy then
		return
	end

	local Character = Player.Character

	if not Character then
		return
	end

	local Root =
		Character:FindFirstChild("HumanoidRootPart")

	if not Root then
		return
	end

	Busy = true

	Root.CFrame =
		CFrame.new(X, Y, Z)

	task.wait(0.15)

	Root.CFrame =
		CFrame.new(Root.Position) *
		CFrame.Angles(math.rad(-90), 0, 0)

	task.wait(0.15)

	-- AUTO-CLICK / PEGA SOZINHO
	ActivateNearbyPrompt(Root)

	task.wait(0.25)

	Busy = false

end

