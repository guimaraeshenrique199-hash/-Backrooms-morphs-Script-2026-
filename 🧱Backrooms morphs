local function GetAllPrompts()

	local List = {}

	for _, Object in ipairs(workspace:GetDescendants()) do

		if Object:IsA("ProximityPrompt")
			and Object.Enabled then

			local Part =
				GetPromptPart(Object)

			if Part then

				table.insert(
					List,
					{
						Prompt = Object,
						Part = Part
					}
				)

			end

		end

	end

	return List
end

